<h2>Movies directed by <%= @movie.director %></h2>

<% if @movies.empty? %>
  <p>No other movies by this director were found.</p>
<% else %>
  <ul id="similar_movies">
    <% @movies.each do |movie| %>
      <li><%= link_to movie.title, movie_path(movie) %></li>
    <% end %>
  </ul>
<% end %>

<%= link_to 'Back to movie list', movies_path, class: 'btn btn-primary' %>
